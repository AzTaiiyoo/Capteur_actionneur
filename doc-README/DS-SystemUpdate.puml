@startuml
' Participants (modules)
participant "Main" as Main #LightBlue
participant "HCSR04" as HCSR04 #LightGreen
participant "Servo" as Servo #LightYellow

title Diagramme de séquence : Mise à jour du système selon l'état

Main -> Main: updateSystem()
activate Main

alt currentState == STATE_IDLE
  note right: Mode IDLE - Repos
  Main -> Servo: Servo_SetToMiddle()
  Main -> Main: Éteindre les LEDs (LED_BLEU_Pin et LED_VERT_Pin)
else currentState == STATE_MODE1
  note right: Mode 1 - Suivi capteur
  Main -> Main: Allumer LED_BLEU_Pin, éteindre LED_VERT_Pin
  Main -> HCSR04: distance = HC_SR04_GetDistance()
  activate HCSR04
  HCSR04 --> Main: retourne distance actuelle
  deactivate HCSR04
  
  alt distance dans la plage valide (5-25 cm)
    Main -> Servo: position = Servo_DistanceToPosition(distance)
    activate Servo
    Servo --> Main: retourne position calculée
    deactivate Servo
    Main -> Servo: Servo_SetPosition(position)
    note right: Le servo suit proportionnellement la distance
    
    ' Envoi de la distance par UART pour informer l'utilisateur
    Main -> Main: Formatage du message "Distance: %.2f cm"
    Main -> Main: Envoi message formaté via UART
  else distance hors plage
    Main -> Servo: Servo_SetToMiddle()
    note right: Position de sécurité par défaut
    Main -> Main: Allumer LED_ROUGE_Pin si > 25cm, LED_ORANGE_Pin si < 5cm
  end
else currentState == STATE_MODE2
  note right: Mode 2 - Commande utilisateur
  Main -> Main: Allumer LED_VERT_Pin, éteindre LED_BLEU_Pin
  Main -> Servo: position = Servo_ValueToPosition(servoPosition)
  activate Servo
  Servo --> Main: retourne position calculée
  deactivate Servo
  Main -> Servo: Servo_SetPosition(position)
  
  ' Continuer à mesurer la distance pour information
  Main -> HCSR04: distance = HC_SR04_GetDistance()
  activate HCSR04
  HCSR04 --> Main: retourne distance actuelle
  deactivate HCSR04
  
  ' Envoi périodique de la distance mesurée
  Main -> Main: Envoi périodique "Distance: %.2f cm" via UART
end

deactivate Main

footer Projet Capteur à Actionneur – Mai 2025
@enduml