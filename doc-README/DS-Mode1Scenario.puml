@startuml
' Participants (modules) avec couleurs
actor "User" as User
participant "Main" as Main #LightBlue
participant "HCSR04" as HCSR04 #LightGreen
participant "Servo" as Servo #LightYellow
participant "USART_COMM" as USART #LightPink

title Scénario d'utilisation: Mode 1 - Suivi de distance

' Activation du Mode 1
User -> USART: Envoie "mode1"
activate USART
USART -> Main: Notification de commande
deactivate USART
activate Main

Main -> Main: currentState = STATE_MODE1
note right: Changement d'état
Main -> Main: Allume LED_BLEU_Pin, éteint LED_VERT_Pin
Main -> USART: sendMessage("Mode 1 activated")
deactivate Main

' Boucle de mesure et contrôle
loop tant que currentState == STATE_MODE1
  activate Main
  Main -> HCSR04: distance = HC_SR04_GetDistance()
  activate HCSR04
  HCSR04 --> Main: Retourne distance
  deactivate HCSR04
  
  alt distance entre 5 et 25 cm
    Main -> Main: Allume LED_ORANGE_Pin, éteint LED_ROUGE_Pin
    Main -> Servo: position = Servo_DistanceToPosition(distance)
    activate Servo
    note right: Conversion linéaire\n5cm → 1000µs (0°)\n25cm → 2000µs (180°)
    Servo --> Main: retourne position calculée
    deactivate Servo
    Main -> Servo: Servo_SetPosition(position)
  else distance hors plage
    Main -> Main: Allume LED_ROUGE_Pin, éteint LED_ORANGE_Pin
    Main -> Servo: Servo_SetToMiddle()
    note right: Position par défaut (90°)
  end
  
  ' Envoi de la distance mesurée via UART
  Main -> USART: sprintf(message, "Distance: %.2f cm", distance)
  Main -> USART: sendMessage(message)
  deactivate Main
  
  ' Sur la Raspberry Pi
  USART --> User: Affiche mesure sur la console
  note right: Les deux servo-moteurs\n(STM32 et Raspberry Pi)\nsuivent la même distance
end

footer Projet Capteur à Actionneur – Mai 2025

@enduml