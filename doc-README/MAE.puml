@startuml

title  Machine à État du projet global

' Point de départ plus explicite
[*] -down-> idle : Démarrage du système

' État IDLE - pas de changement majeur nécessaire
state "IDLE" as idle {
  state "LEDs éteintes" as idle_leds
  state "Servo en position centrale" as idle_servo
  idle_leds -down-> idle_servo
}

' État MODE2
state "MODE2" as mode2 {
  state "LED verte allumée" as mode2_led
  state "Servo STM32 suit consigne série" as mode2_servo_stm
  state "Servo Raspberry suit capteur" as mode2_servo_rasp
  
  mode2_led -down-> mode2_servo_stm
  mode2_servo_stm -down-> mode2_servo_rasp
  
  state value_choice <<choice>>
  mode2_servo_stm -right-> value_choice : Commande\nreçue
  value_choice -up-> mode2_servo_stm : [Valeur 1-12]
  value_choice -right-> mode2_servo_stm : [Valeur invalide]\nPosition inchangée
}

' État MODE1
state "MODE1" as mode1 {
  state "LED bleue allumée" as mode1_led
  state "Les deux servos suivent capteur HC-SR04" as mode1_servo
  mode1_led -down-> mode1_servo
  
  state mode1_choice <<choice>>
  mode1_servo -down-> mode1_choice : Valeur\ndétectée
  mode1_choice -up-> mode1_servo : [Distance 5-25cm]
  mode1_choice -right-> idle_servo : [Distance hors plage]
}

' Transitions entre états principaux avec couleurs pour meilleure lisibilité
idle -down-> mode2 : Commande <mode2>
mode1 -up-> idle : Commande <quit>
idle -up-> mode1 : Commande <mode1>
mode2 -up-> idle : Commande <quit>
mode1 -right-> mode2 : Commande <mode2>
mode2 -right-> mode1 : Commande <mode1>

footer Projet Capteur à Actionneur – Mai 2025

@enduml