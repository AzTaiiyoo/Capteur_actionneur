@startuml
' Style du diagramme simplifié
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' Deux grands packages principaux
package "STM32" {
  class Main {
    - currentState: SystemState
    - servoPosition: int
    + main(): int
    - updateSystem(): void
    - processCommand(command: char*): void
  }

  class HC_SR04 {
    + init(): void
    + getDistance(): float
    + update(): void
  }

  class Servo {
    + init(): void
    + setPosition(position: int): void
    + setToMiddle(): void
    + distanceToPosition(distance: float): int
    + valueToPosition(value: int): int
  }

  class UART {
    + init(): void
    + sendMessage(message: char*): void
    + receiveMessage(): char*
  }
}

package "Raspberry Pi" {
  class RPI_Main {
    - currentMode: int
    - currentDistance: float
    - serialFd: int
    + main(): int
    - handleUserInput(): void
    - printHelp(): void
  }

  class GPIO {
    + setupGPIO(): int
    + writeGPIO(pin: int, value: int): void
  }

  class ServoControl {
    + distanceToPosition(distance: float): int
    + valueToPosition(value: int): int
    + pwmThread(): void
    + servoControlThread(): void
  }

  class SerialComm {
    + openConnection(): int
    + sendCommand(command: char*): void
    + receiveDataThread(): void
  }
}

' Énumérations simplifiées
enum "États du système" as SystemState {
  IDLE
  MODE1 (suivi capteur)
  MODE2 (contrôle manuel)
}

' Constantes partagées
class "Constantes communes" as Constants {
  + SERVO_MIN_POSITION: int = 1000
  + SERVO_MID_POSITION: int = 1500
  + SERVO_MAX_POSITION: int = 2000
  + SERVO_MIN_DISTANCE: float = 5.0
  + SERVO_MAX_DISTANCE: float = 25.0
  + SERVO_MIN_VALUE: int = 1
  + SERVO_MAX_VALUE: int = 12
}

' Relations STM32 - simplifiées
Main --> HC_SR04 : utilise
Main --> Servo : contrôle
Main --> UART : communique
Main --> SystemState : utilise

' Relations Raspberry Pi - simplifiées
RPI_Main --> GPIO : utilise
RPI_Main --> ServoControl : contrôle
RPI_Main --> SerialComm : communique

' Relation STM32 - Raspberry Pi
SerialComm <--> UART : communication UART

' Relations avec constantes - simplifiées
HC_SR04 ..> Constants : utilise
Servo ..> Constants : utilise
ServoControl ..> Constants : utilise

' Threads Raspberry Pi
note right of ServoControl
  Utilise plusieurs threads:
  - Thread PWM pour générer le signal servo
  - Thread de contrôle pour calculer position
end note

note right of SerialComm
  Thread dédié pour recevoir 
  données depuis STM32
end note

note right of RPI_Main
  Thread principal pour
  interface utilisateur
end note

' Note explicative globale
note bottom of Constants
  Le système utilise la communication UART entre STM32 et Raspberry Pi
  pour contrôler deux servo-moteurs selon différents modes.
  Les deux plateformes partagent des constantes et des modes de fonctionnement communs.
end note

title Diagramme de classe simplifié - Système distribué STM32/Raspberry Pi
footer Projet Capteur à Actionneur – Mai 2025
@enduml