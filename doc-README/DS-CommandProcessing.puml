@startuml
' Participants (modules) avec descriptions plus précises
actor "User" as User
participant "Main" as Main #LightBlue
participant "HCSR04" as HCSR04 #LightGreen
participant "Servo" as Servo #LightYellow
participant "USART_COMM" as USART #LightPink

' Titre en haut pour meilleure lisibilité
title Diagramme de séquence : Traitement des commandes utilisateur

' Mise à jour initiale avec une note explicative
note over Main, HCSR04: Lecture constante des caractères entrants via UART

alt message complet reçu entre délimiteurs < et >
  User -> USART: envoi commande
  activate USART
  USART -> Main: message complet détecté et transmis
  deactivate USART
  activate Main
  
  note right of Main: Analyse syntaxique de la commande
  
  alt commande = "mode1"
    Main -> Main: currentState = STATE_MODE1
    Main -> USART: sendMessage("Mode 1 activated")
    note right: La LED bleue sera allumée au prochain updateSystem()
  else commande = "mode2"
    Main -> Main: currentState = STATE_MODE2
    Main -> USART: sendMessage("Mode 2 activated")
    note right: La LED verte sera allumée au prochain updateSystem()
  else commande = "quit"
    Main -> Main: currentState = STATE_IDLE
    Main -> USART: sendMessage("Returned to idle state")
    note right: Les LEDs seront éteintes au prochain updateSystem()
  else commande = "getdistance"
    Main -> HCSR04: distance = HC_SR04_GetDistance()
    Main -> USART: sendMessage("LastDistance: %.2f cm", distance)
    note right: Commande spéciale pour obtenir la distance actuelle
  else commande = "demo"
    Main -> Main: Lance séquence de démonstration
    Main -> USART: sendMessage("Demo mode activated")
    note right: Mode spécial pour démonstration
  else commande = valeur entre 1-12
    alt si currentState == STATE_MODE2
      Main -> Main: servoPosition = valeur
      Main -> USART: sendMessage("Servo position set to %d", valeur)
    else
      Main -> USART: sendMessage("Error: Can only set position in MODE2")
    end
  else
    Main -> USART: sendMessage("Unknown command: %s", command)
  end
  deactivate Main
end

footer Projet Capteur à Actionneur – Mai 2025

@enduml